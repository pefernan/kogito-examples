{
  "id": "startWithCloudEvent",
  "version": "1.0",
  "expressionLang": "jsonpath",
  "name": "Workflow test - Rest Form",
  "description": "An example of how to consume events over HTTP",
  "events": [
    {
      "name": "start",
      "source": "/from/quarkus-dev-ui",
      "type": "start"
    },
    {
      "name": "startfromtopic",
      "source": "topic",
      "type": "startfromtopic"
    },
    {
      "name": "moveEvent2",
      "source": "",
      "type": "move"
    }
  ],
  "functions": [
    {
      "name": "printMessage",
      "type": "custom",
      "operation": "sysout"
    }
  ],
  "start": "printWaitMessage",
  "states": [
    {
      "name": "printWaitMessage",
      "type": "event",
      "onEvents": [
        {
          "eventRefs": ["start"],
          "actions": [
            {
              "name": "printBeforeEvent",
              "functionRef": {
                "refName": "printMessage",
                "arguments": {
                  "message": "$[*]"
                }
              }
            }
          ]
        }
      ],
      "transition": "waitForEvent"
    },
    {
      "name": "waitForEvent",
      "type": "event",
       "onEvents": [
        {
          "eventRefs": [
            "moveEvent2"
          ],
          "actions": [ 
          {
            "name": "printAfterEvent",
            "functionRef": {
              "refName": "printMessage",
              "arguments": {
                 "message": "$[*]"
              }
            }
          }
          ]
        }
       ], 
      "end": {
        "terminate": "true"
      }
    }
  ]
}